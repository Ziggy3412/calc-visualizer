{
  "name": "calc-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "electron:preview": "vite build && electron .",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "@clerk/react": "^6.19.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "katex": "^0.17.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "plotly.js": "^3.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-katex": "^3.1.0",
    "react-plotly.js": "^4.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.calcvisualizer.app",
    "productName": "Calc Visualizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    }
  },
  "_TODO_codeSigning": "Both build:win and build:mac produce UNSIGNED builds. To sign later: Windows needs a code-signing cert wired into build.win.certificateFile/certificatePassword (or CSC_LINK/CSC_KEY_PASSWORD env vars); Mac needs an Apple Developer ID cert wired into build.mac.identity plus a notarize step (electron-builder's afterSign hook or the `notarize` option), which requires an Apple Developer account. This key is just a note for humans — electron-builder only reads the 'build' key above and ignores this one."
}
